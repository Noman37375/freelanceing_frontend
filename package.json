{
  "name": "pakistan-freelance-app",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "dev": "cross-env EXPO_NO_TELEMETRY=1 expo start",
    "icons:generate": "node ./scripts/generate-icons.mjs",
    "pwa:postbuild": "node ./scripts/pwa-postbuild.mjs",
    "build": "npm run icons:generate && expo export --platform web && npm run pwa:postbuild",
    "build:web": "npm run icons:generate && expo export --platform web && npm run pwa:postbuild",
    "preview": "npx serve -p 8080",
    "build:web:preview": "npm run build:web && npm run preview",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
